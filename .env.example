# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Embedding Model (Sentence Transformers default or HuggingFace model)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Admin Authentication
# Set a unique password in your local .env file before enabling admin access.
ADMIN_PASSWORD=

# Database Paths
SQLITE_DB_PATH=database/schemes.db
CHROMA_PERSIST_DIR=database/chroma_db

# Local Offline LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
DEFAULT_LLM_PROVIDER=auto

# App Settings
DEFAULT_LANGUAGE=English
DEBUG_MODE=False
